page {
  min-height: 100%;
  background: linear-gradient(180deg, #f5fbff 0%, #edf6fc 52%, #ffffff 100%);
  color: #0b1f33;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
}

input,
picker,
textarea {
  box-sizing: border-box;
}
